SUPABASE_URL=https://your-project.supabase.co
# Serverový klient (db/supabase.py) sdílený pro všechny requesty -> SECRET klíč
# (sb_secret_... / legacy service_role), ne publishable/anon. Nikdy ne do klienta.
SUPABASE_KEY=sb_secret_...

# Přímé Postgres připojení pro transakční /action (asyncpg).
# Supabase Dashboard → Connect → Session pooler (port 5432):
DATABASE_URL=postgresql://postgres.your-project:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres
ANTHROPIC_API_KEY=sk-ant-...
ENGINE_VERSION=1.0.0
# Od migrace 004: adventurer-0.1.0 (engine/ruleset.py RULESETS registry)
RULESET_VERSION=adventurer-0.1.0

# Phase 2A Visualizer — DALL-E 3 integrace
# Přidat ručně do Railway environment variables
OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024

# Vision Credits (GDD Addendum G/H)
# test mode: true = generování zdarma (kredity se nestrhávají)
VISUALIZER_TEST_MODE=true
VISION_FREE_ONBOARDING_CREDITS=3
VISION_SCENE_COST=1
# Cooldown nabídek vizualizace v ticích (GDD 23.21); 0 = vypnuto
VISION_OFFER_COOLDOWN_TICKS=5

# JWT verifikace: ES256/RS256 tokeny se ověřují automaticky přes JWKS
# ({SUPABASE_URL}/auth/v1/.well-known/jwks.json) — není potřeba nic nastavovat.
# Pouze pro legacy projekty s HS256 tokeny odkomentuj a vyplň:
# SUPABASE_JWT_SECRET=your-legacy-jwt-secret

# --- Jen pro testy (tests/test_acceptance.py), v produkci nenastavovat ---
# Adresa běžícího backendu; výchozí http://localhost:8000
TEST_BASE_URL=http://localhost:8000
# Supabase access token testovacího uživatele: python scripts/get_token.py <email> <heslo>
# Token platí ~1 hodinu. Bez něj se živé testy přeskočí.
TEST_JWT_TOKEN=
# Token DRUHÉHO účtu pro test vlastnictví kampaní (volitelný, jinak se test přeskočí)
TEST_JWT_TOKEN_2=
